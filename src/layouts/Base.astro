---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { 
  title = "Relajo Desierto - Bienestar en el Atacama",
  description = "Tinaja, jacuzzi y cabaña con hidromasaje en el desierto de Atacama. Experiencias de turismo y bienestar en Copiapó.",
  image = "/og-image.jpg"
} = Astro.props;

const canonical = Astro.url.href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#d8704d" />
    
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- OG Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:type" content="website" />
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Fira+Code:wght@400&display=swap" rel="stylesheet" />
    
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --color-primary: #d8704d;
    --color-primary-fg: #ffffff;
    --color-background: #fafaf8;
    --color-surface: #ffffff;
    --color-border: #e5e0d9;
    --color-fg: #2b2b2a;
    --color-fg-muted: #6b6b6a;
    --color-success: #4caf50;
    --color-destructive: #c62828;
  }
</style>
