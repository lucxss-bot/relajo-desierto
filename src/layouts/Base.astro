---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import { site } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = `${site.name} — ${site.tagline}`,
  description = site.description,
  image = "/og-image.jpg",
} = Astro.props;

const canonical = Astro.url.href;
const ogImage = new URL(image, Astro.site ?? Astro.url).href;

// Schema.org LocalBusiness — es lo que Google lee para búsquedas locales
// del tipo "tinaja Copiapó" y para la ficha en Maps.
const schema = {
  "@context": "https://schema.org",
  "@type": "LodgingBusiness",
  name: site.name,
  description: site.description,
  url: canonical,
  telephone: site.phoneDisplay,
  image: ogImage,
  priceRange: "$$",
  address: {
    "@type": "PostalAddress",
    streetAddress: `${site.address.street}, ${site.address.locality}`,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  hasMap: site.mapsUrl,
  geo: {
    "@type": "GeoCoordinates",
    latitude: site.geo.lat,
    longitude: site.geo.lng,
  },
  sameAs: [site.instagram],
  amenityFeature: [
    { "@type": "LocationFeatureSpecification", name: "Tinaja con hidromasaje", value: true },
    { "@type": "LocationFeatureSpecification", name: "Jacuzzi", value: true },
    { "@type": "LocationFeatureSpecification", name: "Desayuno incluido", value: true },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#c1593a" />

    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:SOFT,WONK,opsz,wght@0..100,0..1,9..144,400..700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    {/* Cuenta visitas sin cookies ni datos personales, así que no necesita
        aviso de consentimiento. Hay que activarlo además en el panel de
        Vercel: Analytics -> Enable. */}
    <Analytics />
  </head>
  <body>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-fg"
    >
      Saltar al contenido
    </a>
    <slot />

    <script is:inline>
      (() => {
        const root = document.documentElement;
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        root.classList.add("js-reveal");

        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("is-visible");
              io.unobserve(entry.target);
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
        );

        const observe = () => {
          for (const el of document.querySelectorAll("[data-reveal]")) io.observe(el);
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", observe);
        } else {
          observe();
        }

        // Red de seguridad: si a los 3 s no se reveló nada, el observer no está
        // funcionando. Quitamos la clase para que el contenido nunca quede invisible.
        setTimeout(() => {
          if (document.querySelector("[data-reveal].is-visible")) return;
          root.classList.remove("js-reveal");
        }, 3000);
      })();
    </script>

    <script is:inline>
      // Traspaso a WhatsApp. Entre el toque y la apertura de la app pasan
      // hasta 800 ms en los que no ocurre nada visible, y es justo el único
      // momento de conversión de la página. El enlace se queda atenuado
      // hasta que se vuelve a la pestaña.
      (() => {
        const limpiar = (el) => el.classList.remove("is-launching");

        for (const enlace of document.querySelectorAll('a[href*="wa.me"]')) {
          enlace.addEventListener("pointerdown", () => {
            enlace.classList.add("is-launching");
            // Si la app no llega a abrirse, no dejarlo apagado para siempre.
            setTimeout(() => limpiar(enlace), 4000);
          });
          enlace.addEventListener("pointercancel", () => limpiar(enlace));
        }

        document.addEventListener("visibilitychange", () => {
          if (document.visibilityState !== "visible") return;
          for (const el of document.querySelectorAll(".is-launching")) limpiar(el);
        });
      })();
    </script>
  </body>
</html>
