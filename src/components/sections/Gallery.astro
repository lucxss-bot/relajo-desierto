---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

import desayuno from "../../assets/fotos/desayuno.jpg";
import tabla from "../../assets/fotos/tabla.jpg";
import jardinNoche from "../../assets/fotos/jardin-noche.jpg";
import nocheCopas from "../../assets/fotos/noche-copas.jpg";

interface Photo {
  src: ImageMetadata;
  alt: string;
  caption: string;
}

const photos: Photo[] = [
  {
    src: tabla,
    alt: "Tabla de picoteo con quesos, frutas y espumante en Relajo Desierto",
    caption: "La tabla que viene con tu tinaja",
  },
  {
    src: desayuno,
    alt: "Bandeja de desayuno con café, sándwiches y fruta fresca en la cabaña",
    caption: "Desayuno incluido en la cabaña",
  },
  {
    src: nocheCopas,
    alt: "Dos copas de espumante servidas de noche junto al sector de tinajas",
    caption: "Espumante incluido, siempre",
  },
  {
    src: jardinNoche,
    alt: "Jardín de cactus y yucas del desierto iluminado de noche",
    caption: "El desierto, de noche",
  },
];
---

<section class="bg-background px-5 pb-20 sm:px-6 sm:pb-28">
  <div class="mx-auto max-w-6xl">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="eyebrow justify-center">El lugar</p>
      <h2 class="mt-5 text-fg">Así se ve por acá</h2>
    </div>

    <div class="mt-12 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
      {
        photos.map((photo, i) => (
          <figure
            class="group relative overflow-hidden rounded-2xl"
            data-reveal
            style={`transition-delay: ${i * 90}ms`}
          >
            <Image
              src={photo.src}
              alt={photo.alt}
              class="aspect-[4/5] w-full object-cover transition-transform duration-700 ease-out-soft group-hover:scale-105"
              widths={[300, 480, 640]}
              sizes="(min-width: 1024px) 25vw, 50vw"
              loading="lazy"
            />

            <div
              class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/85 via-ink/35 to-transparent p-4 pt-12"
              aria-hidden="true"
            />

            <figcaption class="absolute inset-x-0 bottom-0 p-4 text-sm font-medium text-primary-fg">
              {photo.caption}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
