---
import { Image } from "astro:assets";
import { site, whatsappLink } from "../../lib/site";
import Icon from "../ui/Icon.astro";
import logo from "../../assets/fotos/logo.jpg";

const year = new Date().getFullYear();

const links = [
  { label: "Experiencias", href: "#experiencias" },
  { label: "Nosotros", href: "#nosotros" },
  { label: "Opiniones", href: "#opiniones" },
  { label: "Reservas", href: "#contacto" },
];

const socials = [
  { label: "WhatsApp", href: whatsappLink(`Hola ${site.name}!`), icon: "whatsapp" as const },
  { label: "Instagram", href: site.instagram, icon: "instagram" as const },
];
---

<footer class="border-t border-primary-fg/10 bg-ink px-5 pb-10 pt-14 text-primary-fg sm:px-6">
  <div class="mx-auto max-w-6xl">
    <div class="flex flex-col gap-10 sm:flex-row sm:items-start sm:justify-between">
      <div class="max-w-xs">
        <Image
          src={logo}
          alt={`${site.name} — ${site.slogan}`}
          class="w-40 rounded-xl bg-white p-3"
          widths={[160, 320]}
          sizes="160px"
          loading="lazy"
        />
        <p class="mt-4 text-sm text-primary-fg/55">
          {site.tagline}. {site.address.full}.
        </p>
      </div>

      <nav aria-label="Pie de página">
        <ul class="flex flex-wrap gap-x-7 gap-y-2.5 text-sm">
          {
            links.map((link) => (
              <li>
                <a href={link.href} class="text-primary-fg/65 transition-colors hover:text-primary-fg">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex gap-3">
        {
          socials.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={social.label}
              class="flex size-10 items-center justify-center rounded-full border border-primary-fg/15 text-primary-fg/70 transition-colors hover:border-primary hover:bg-primary hover:text-primary-fg"
            >
              <Icon name={social.icon} class="size-[1.15rem]" />
            </a>
          ))
        }
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-2 border-t border-primary-fg/10 pt-7 text-xs text-primary-fg/40 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} {site.name}. Todos los derechos reservados.</p>
      <p>{site.address.city}, Región de {site.address.region}, Chile</p>
    </div>
  </div>
</footer>
