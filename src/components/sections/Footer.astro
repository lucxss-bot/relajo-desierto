---
import { getSiteSettings } from "../lib/sanity";

const settings = await getSiteSettings();

const whatsappNumber = settings?.whatsappNumber || "56912345678";
const phoneNumber = settings?.phoneNumber || "+56 9 1234 5678";
const instagramHandle = settings?.instagramHandle || "relajo.desierto";
const address = settings?.address || "Chamonate, Copiapó, Atacama, Chile";
const businessName = settings?.businessName || "Relajo Desierto";
const year = new Date().getFullYear();
---

<footer class="bg-fg text-primary-fg py-12 px-4">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      <!-- Contact -->
      <div class="space-y-4">
        <h3 class="font-semibold text-lg">{businessName}</h3>
        <p class="text-sm opacity-90">{address}</p>
      </div>

      <!-- Contact Links -->
      <div class="space-y-3">
        <h4 class="font-semibold">Contacto</h4>
        <div class="flex flex-col gap-2 text-sm">
          <a href={`https://wa.me/${whatsappNumber}`} class="hover:underline flex items-center gap-2">
            💬 WhatsApp
          </a>
          <a href={`tel:${phoneNumber}`} class="hover:underline flex items-center gap-2">
            📞 Llamar
          </a>
          <a href={`https://instagram.com/${instagramHandle}`} class="hover:underline flex items-center gap-2">
            📸 Instagram
          </a>
        </div>
      </div>

      <!-- Info -->
      <div class="space-y-3">
        <h4 class="font-semibold">Información</h4>
        <div class="text-sm space-y-2">
          <p>Tinaja • Jacuzzi • Cabaña</p>
          <p>Bienestar en el Desierto</p>
        </div>
      </div>
    </div>

    <!-- Copyright -->
    <div class="border-t border-primary-fg/20 pt-8 text-center text-sm opacity-75">
      <p>&copy; {year} {businessName}. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>
