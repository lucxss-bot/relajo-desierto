---
import { Image } from "astro:assets";
import { site, whatsappLink } from "../../lib/site";
import Icon from "../ui/Icon.astro";
import logoMarca from "../../assets/fotos/logo-marca.png";

const links = [
  { label: "Experiencias", href: "#experiencias" },
  { label: "Nosotros", href: "#nosotros" },
  { label: "Opiniones", href: "#opiniones" },
  { label: "Ubicación", href: "#contacto" },
];

const cta = whatsappLink(`Hola ${site.name}! Quiero consultar disponibilidad.`);
---

{/* Testigo del alto del hero: mientras siga a la vista, la barra queda
    transparente. Se mide desde el flujo, no con listener de scroll. */}
<span id="nav-sentinel" class="pointer-events-none absolute top-0 h-[60svh] w-px" aria-hidden="true"></span>

<header data-nav class="sticky top-0 z-50 border-b">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 sm:px-6" aria-label="Principal">
    <a href="#" class="flex min-h-11 items-center gap-2.5" aria-label={`${site.name} — inicio`}>
      <Image
        src={logoMarca}
        alt=""
        class="nav-mark h-9 w-auto"
        widths={[172, 344]}
        sizes="86px"
        loading="eager"
      />
      <span class="nav-brand-text hidden font-display text-lg font-semibold tracking-tight sm:inline">
        Relajo Desierto
      </span>
    </a>

    <ul class="hidden items-center gap-8 md:flex">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="nav-link inline-flex min-h-11 items-center text-sm transition-colors">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href={cta}
      target="_blank"
      rel="noopener noreferrer"
      class="pressable inline-flex min-h-11 items-center gap-2 rounded-full bg-primary px-5 text-sm font-medium text-primary-fg shadow-soft hover:bg-primary-deep"
    >
      <Icon name="whatsapp" class="size-4" />
      <span class="hidden sm:inline">Reservar</span>
      <span class="sm:hidden">WhatsApp</span>
    </a>
  </nav>
</header>

<script is:inline>
  (() => {
    const nav = document.querySelector("[data-nav]");
    const sentinel = document.getElementById("nav-sentinel");
    // Sin observer la barra se queda sólida, que es el estado legible.
    if (!nav || !sentinel || !("IntersectionObserver" in window)) return;

    // Se aplica de inmediato para no mostrar un fotograma de barra sólida
    // encima del hero antes de la primera llamada del observer.
    if (window.scrollY < 4) nav.classList.add("at-top");

    const io = new IntersectionObserver(
      ([entry]) => nav.classList.toggle("at-top", entry.isIntersecting),
      { rootMargin: "-64px 0px 0px 0px", threshold: 0 },
    );
    io.observe(sentinel);
  })();
</script>
