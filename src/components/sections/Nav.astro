---
import { Image } from "astro:assets";
import { site, whatsappLink } from "../../lib/site";
import Icon from "../ui/Icon.astro";
import logoMarca from "../../assets/fotos/logo-marca.png";

const links = [
  { label: "Experiencias", href: "#experiencias" },
  { label: "Tinaja y jacuzzi", href: "#opciones" },
  { label: "Nosotros", href: "#nosotros" },
  { label: "Ubicación", href: "#contacto" },
];

const cta = whatsappLink(`Hola ${site.name}! Quiero consultar disponibilidad.`);
---

<header class="sticky top-0 z-50 border-b border-border/70 bg-background/85 backdrop-blur-md">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 sm:px-6" aria-label="Principal">
    <a
      href="#"
      class="flex min-h-11 items-center gap-2.5"
      aria-label={`${site.name} — inicio`}
    >
      <Image
        src={logoMarca}
        alt=""
        class="h-9 w-auto"
        widths={[172, 344]}
        sizes="86px"
        loading="eager"
      />
      <span class="hidden font-display text-lg font-semibold tracking-tight text-fg sm:inline">
        Relajo Desierto
      </span>
    </a>

    <ul class="hidden items-center gap-8 md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="inline-flex min-h-11 items-center text-sm text-fg-muted transition-colors hover:text-primary-deep"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href={cta}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex min-h-11 items-center gap-2 rounded-full bg-primary px-5 text-sm font-medium text-primary-fg transition-colors hover:bg-primary-deep"
    >
      <Icon name="whatsapp" class="size-4" />
      <span class="hidden sm:inline">Reservar</span>
      <span class="sm:hidden">WhatsApp</span>
    </a>
  </nav>
</header>
