---
import { site, whatsappLink } from "../../lib/site";
import Icon from "../ui/Icon.astro";

const cta = whatsappLink(`Hola ${site.name}! Quiero reservar. ¿Qué fechas tienen disponibles?`);

const pasos = [
  {
    title: "Escríbenos",
    detail: "Nos cuentas la fecha, cuántos son y si prefieres tinaja o jacuzzi.",
  },
  {
    title: "Abonas el 50%",
    detail: "Por transferencia. Con eso tu fecha queda tomada.",
  },
  {
    title: "Pagas el resto al llegar",
    detail: "El 50% restante se paga el día de la reserva o al ingresar.",
  },
];

const channels = [
  {
    label: "WhatsApp",
    value: "Respondemos en el día",
    href: cta,
    icon: "whatsapp" as const,
    external: true,
    primary: true,
  },
  {
    label: "Teléfono",
    value: site.phoneDisplay,
    href: site.phoneHref,
    icon: "phone" as const,
    external: false,
  },
  {
    label: "Instagram",
    value: site.instagramHandle,
    href: site.instagram,
    icon: "instagram" as const,
    external: true,
  },
];
---

<section
  id="contacto"
  class="grain grain-dark relative scroll-mt-20 overflow-hidden bg-ink px-5 py-band-lg text-primary-fg sm:px-6"
>
  <!-- Puente de crema a oscuro. Sin él, el salto desde la sección anterior
       se lee como un bloque pegado en medio de una página clara. -->
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-background to-transparent opacity-[0.07]"
    aria-hidden="true"
  >
  </div>

  <!-- Resplandor cálido, desplazado a la izquierda para acompañar el
       texto en vez de quedar centrado detrás de todo. -->
  <div
    class="pointer-events-none absolute left-0 top-0 size-[46rem] -translate-x-1/3 -translate-y-1/3 rounded-full"
    style="background: radial-gradient(circle, rgba(189,86,55,0.34) 0%, rgba(189,86,55,0) 66%);"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-6xl">
    <div class="max-w-2xl">
      <p class="eyebrow !text-primary-fg/60 [&::before]:bg-primary-fg/30" data-reveal>Reservas</p>

      <h2
        class="mt-6 text-headline leading-[1.06] tracking-[-0.025em] text-primary-fg"
        data-reveal
        style="transition-delay: 70ms"
      >
        ¿Nos vemos en el desierto?
      </h2>

      <p class="mt-6 text-lg text-primary-fg/75" data-reveal style="transition-delay: 140ms">
        Escríbenos y coordinamos tu fecha. Sin formularios ni esperas: hablas directo con nosotros.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-3" data-reveal style="transition-delay: 210ms">
      {
        channels.map((channel) => (
          <a
            href={channel.href}
            target={channel.external ? "_blank" : undefined}
            rel={channel.external ? "noopener noreferrer" : undefined}
            class={`pressable group flex items-center gap-4 rounded-lg border p-5 sm:p-6 ${
              channel.primary
                ? "border-primary bg-primary hover:bg-primary-deep"
                : "border-primary-fg/15 bg-primary-fg/[0.04] hover:border-primary-fg/30 hover:bg-primary-fg/[0.08]"
            }`}
          >
            <Icon name={channel.icon} class="size-6 shrink-0" />
            <span class="min-w-0 text-left">
              <span class="block font-medium">{channel.label}</span>
              {/* Sobre el terracota, el blanco a opacidad reducida no llega a 4.5:1 */}
              <span class={`block text-sm ${channel.primary ? "text-primary-fg" : "text-primary-fg/65"}`}>
                {channel.value}
              </span>
            </span>
          </a>
        ))
      }
    </div>

    <div class="mt-14 border-t border-primary-fg/12 pt-12" data-reveal style="transition-delay: 280ms">
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-primary-fg/50">Cómo reservar</p>

      <ol class="mt-7 grid grid-cols-1 gap-6 text-left sm:grid-cols-3">
        {
          pasos.map((paso, i) => (
            <li class="flex gap-4">
              <span class="flex size-8 shrink-0 items-center justify-center rounded-full border border-primary-fg/25 font-display text-sm font-semibold text-primary-fg/80">
                {i + 1}
              </span>
              <div>
                <p class="font-medium text-primary-fg">{paso.title}</p>
                <p class="mt-1 text-sm text-primary-fg/60">{paso.detail}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div
      class="mt-12 border-t border-primary-fg/12 pt-10"
      data-reveal
      style="transition-delay: 350ms"
    >
      <div class="mx-auto flex max-w-xl flex-col items-center gap-5">
        <div class="space-y-2 text-sm text-primary-fg/70">
          <p class="inline-flex items-center justify-center gap-2">
            <Icon name="pin" class="size-4 shrink-0 text-primary-fg/50" />
            {site.address.full}
          </p>
          <p class="inline-flex items-center justify-center gap-2">
            <Icon name="clock" class="size-4 shrink-0 text-primary-fg/50" />
            {site.hours}
          </p>
        </div>

        {/* La dirección por sí sola no se encuentra en Maps: son parcelas.
            Por eso el botón lleva a las coordenadas exactas. */}
        <a
          href={site.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="pressable inline-flex min-h-11 items-center gap-2 rounded-full border border-primary-fg/25 px-6 py-3 font-medium text-primary-fg hover:border-primary-fg/50 hover:bg-primary-fg/10"
        >
          <Icon name="pin" class="size-[1.05rem]" />
          Cómo llegar en Google Maps
        </a>

        <p class="text-xs text-primary-fg/50">
          El pasaje no aparece por nombre en Maps. El botón te lleva directo al punto.
        </p>
      </div>
    </div>
  </div>
</section>
