---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { clp, whatsappLink } from "../../lib/site";
import Icon from "../ui/Icon.astro";
import type { IconName } from "../../lib/icons";

import fotoTinaja from "../../assets/fotos/tinaja.jpg";
import fotoCabana from "../../assets/fotos/cabanas-atardecer.jpg";

interface Paquete {
  name: string;
  subtitle: string;
  meta: string;
  price: number;
  priceNote: string;
  extra?: string;
  features: string[];
  photo: ImageMetadata;
  alt: string;
  badge?: string;
  featured?: boolean;
}

const paquetes: Paquete[] = [
  {
    name: "Experiencia",
    subtitle: "Tinaja o jacuzzi, sin alojamiento",
    meta: "90 minutos",
    price: 67000,
    priceNote: "por 2 personas",
    extra: "Persona adicional: $15.000",
    features: [
      "90 minutos de tinaja o jacuzzi, a elección",
      "Tabla de picoteo",
      "Pizzetas",
      "Espumante",
      "Batas para usar durante la experiencia",
      "Souvenir de regalo",
    ],
    photo: fotoTinaja,
    alt: "Tinaja de madera con agua caliente bajo techo de totora en Relajo Desierto",
  },
  {
    name: "Alojamiento + Experiencia",
    subtitle: "Con noche en cabaña",
    meta: "Ingreso 16:00 · salida 12:00 del día siguiente",
    price: 120000,
    priceNote: "por 2 personas",
    features: [
      "90 minutos de tinaja o jacuzzi, a elección",
      "Alojamiento en cabaña equipada",
      "2 desayunos",
      "Tabla de picoteo",
      "Pizzetas",
      "Botella de espumante",
      "Batas para usar durante la estadía",
      "Souvenir de regalo",
    ],
    photo: fotoCabana,
    alt: "Cabañas de adobe con techo de totora al atardecer en Relajo Desierto",
    badge: "La más completa",
    featured: true,
  },
];

interface OpcionAgua {
  name: string;
  capacity: string;
  detail: string;
  icon: IconName;
}

const opcionesAgua: OpcionAgua[] = [
  {
    name: "Tinaja",
    capacity: "Hasta 6 personas",
    detail: "De madera, con hidromasaje, bajo techo de totora.",
    icon: "tinaja",
  },
  {
    name: "Jacuzzi",
    capacity: "Hasta 4 personas",
    detail: "Con hidroburbujas, en un espacio más recogido.",
    icon: "jacuzzi",
  },
];
---

<section id="experiencias" class="scroll-mt-20 bg-background px-5 py-20 sm:px-6 sm:py-28">
  <div class="mx-auto max-w-6xl">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="eyebrow justify-center">Nuestras experiencias</p>
      <h2 class="mt-5 text-fg">Dos formas de vivirlo</h2>
      <p class="mt-4 text-lg text-fg-muted">
        Por unas horas o con noche incluida. En las dos eliges tinaja o jacuzzi, y las dos vienen con tabla,
        pizzetas y espumante.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
      {
        paquetes.map((paquete, i) => (
          <article
            class={`group relative flex flex-col overflow-hidden rounded-2xl border bg-surface shadow-soft transition-all duration-500 ease-out-soft hover:-translate-y-1 hover:shadow-lift ${
              paquete.featured ? "border-primary/35" : "border-border"
            }`}
            data-reveal
            style={`transition-delay: ${i * 110}ms`}
          >
            <div class="relative h-60 overflow-hidden sm:h-64">
              <Image
                src={paquete.photo}
                alt={paquete.alt}
                class="size-full object-cover transition-transform duration-700 ease-out-soft group-hover:scale-105"
                widths={[480, 720, 960]}
                sizes="(min-width: 768px) 50vw, 100vw"
                loading="lazy"
              />
              <div
                class="absolute inset-0 bg-gradient-to-t from-ink/45 via-transparent to-transparent"
                aria-hidden="true"
              />
              {paquete.badge && (
                <span class="absolute right-4 top-4 rounded-full bg-primary px-3 py-1 text-xs font-semibold text-primary-fg">
                  {paquete.badge}
                </span>
              )}
            </div>

            <div class="flex flex-1 flex-col p-6 sm:p-8">
              <h3 class="text-2xl text-fg">{paquete.name}</h3>
              <p class="mt-1 text-primary-deep">{paquete.subtitle}</p>

              <p class="mt-3 inline-flex items-center gap-1.5 text-sm text-fg-subtle">
                <Icon name="clock" class="size-4 shrink-0" />
                {paquete.meta}
              </p>

              <p class="mt-6 text-xs font-semibold uppercase tracking-[0.14em] text-fg-subtle">Incluye</p>
              <ul class="mt-3 space-y-2.5">
                {paquete.features.map((feature) => (
                  <li class="flex items-start gap-2.5 text-sm text-fg-muted">
                    <Icon name="check" class="mt-0.5 size-4 shrink-0 text-primary" />
                    {feature}
                  </li>
                ))}
              </ul>

              <div class="mt-auto pt-7">
                <div class="flex items-end justify-between gap-4 border-t border-border pt-5">
                  <div>
                    <p class="font-display text-3xl font-semibold text-fg">{clp(paquete.price)}</p>
                    <p class="text-xs text-fg-subtle">{paquete.priceNote}</p>
                  </div>
                  {paquete.extra && (
                    <p class="rounded-full bg-primary-soft px-3 py-1.5 text-xs font-medium text-primary-deep">
                      {paquete.extra}
                    </p>
                  )}
                </div>

                <a
                  href={whatsappLink(`Hola! Quiero reservar "${paquete.name}". ¿Qué fechas tienen disponibles?`)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={`mt-5 inline-flex w-full items-center justify-center gap-2 rounded-full px-5 py-3.5 font-medium transition-all duration-300 active:scale-[0.98] ${
                    paquete.featured
                      ? "bg-primary text-primary-fg hover:bg-primary-deep"
                      : "border border-border bg-surface text-fg hover:border-primary/40 hover:bg-primary-soft hover:text-primary-deep"
                  }`}
                >
                  <Icon name="whatsapp" class="size-[1.05rem]" />
                  Reservar por WhatsApp
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    {/* Elección de tinaja o jacuzzi, común a los dos paquetes */}
    <div
      class="mt-8 rounded-2xl border border-border bg-surface-alt p-6 sm:p-8"
      data-reveal
      style="transition-delay: 220ms"
    >
      <p class="text-center text-sm font-semibold uppercase tracking-[0.14em] text-primary-deep">
        En cualquiera de las dos, eliges
      </p>

      <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
        {
          opcionesAgua.map((opcion) => (
            <div class="flex items-start gap-4 rounded-xl bg-surface p-5">
              <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-primary-soft text-primary-deep">
                <Icon name={opcion.icon} class="size-6" />
              </span>
              <div>
                <p class="flex flex-wrap items-baseline gap-x-2.5">
                  <span class="font-display text-lg font-semibold text-fg">{opcion.name}</span>
                  <span class="text-sm text-primary-deep">{opcion.capacity}</span>
                </p>
                <p class="mt-1 text-sm text-fg-muted">{opcion.detail}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
