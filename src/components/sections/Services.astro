---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { clp, whatsappLink } from "../../lib/site";
import Icon from "../ui/Icon.astro";
import type { IconName } from "../../lib/icons";

import fotoTinaja from "../../assets/fotos/tinaja.jpg";
import fotoJacuzzi from "../../assets/fotos/noche-copas.jpg";
import fotoCabana from "../../assets/fotos/cabanas-atardecer.jpg";

interface Service {
  name: string;
  tagline: string;
  description: string;
  price: number;
  priceNote: string;
  capacity: string;
  features: string[];
  icon: IconName;
  photo: ImageMetadata;
  alt: string;
  featured?: boolean;
}

const services: Service[] = [
  {
    name: "Tinaja",
    tagline: "La clásica del desierto",
    description:
      "Tinaja de madera con agua caliente e hidromasaje, bajo techo de totora. El plan ideal para venir con amigos o en familia.",
    price: 45000,
    priceNote: "por sesión",
    capacity: "Hasta 6 personas",
    features: ["Hidromasaje", "Tabla para picar", "Bebestible incluido", "Ambiente techado y privado"],
    icon: "tinaja",
    photo: fotoTinaja,
    alt: "Tinaja de madera con agua caliente bajo techo de totora en Relajo Desierto",
    featured: true,
  },
  {
    name: "Jacuzzi",
    tagline: "Para dos",
    description:
      "Jacuzzi con hidroburbujas pensado para parejas. Más íntimo, más tranquilo, con la misma noche de desierto encima.",
    price: 25000,
    priceNote: "por sesión",
    capacity: "Para 2 personas",
    features: ["Hidroburbujas", "Tabla para picar", "Bebestible incluido", "Ambiente privado"],
    icon: "jacuzzi",
    // TODO: reemplazar por una foto real del jacuzzi cuando la tengamos.
    photo: fotoJacuzzi,
    alt: "Dos copas servidas de noche en el sector de tinajas de Relajo Desierto",
  },
  {
    name: "Cabaña",
    tagline: "Con noche incluida",
    description:
      "Cabaña de adobe equipada para dos, con desayuno de cortesía y la tinaja o el jacuzzi incluidos en la estadía.",
    price: 120000,
    priceNote: "por noche",
    capacity: "Alojamiento para 2",
    features: ["Desayuno incluido", "Baño privado y frigobar", "Elige tinaja o jacuzzi", "Ropa de cama incluida"],
    icon: "cabana",
    photo: fotoCabana,
    alt: "Cabañas de adobe con techo de totora al atardecer en Relajo Desierto",
  },
];
---

<section id="experiencias" class="scroll-mt-20 bg-background px-5 py-20 sm:px-6 sm:py-28">
  <div class="mx-auto max-w-6xl">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="eyebrow justify-center">Nuestras experiencias</p>
      <h2 class="mt-5 text-fg">Elige cómo quieres relajarte</h2>
      <p class="mt-4 text-lg text-fg-muted">
        Tres formas de desconectarse en el desierto. Todas incluyen agua caliente, privacidad y cero apuro.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-7">
      {
        services.map((service, i) => (
          <article
            class={`group relative flex flex-col overflow-hidden rounded-2xl border bg-surface shadow-soft transition-all duration-500 ease-out-soft hover:-translate-y-1 hover:shadow-lift ${
              service.featured ? "border-primary/35" : "border-border"
            }`}
            data-reveal
            style={`transition-delay: ${i * 110}ms`}
          >
            <div class="relative h-56 overflow-hidden">
              <Image
                src={service.photo}
                alt={service.alt}
                class="size-full object-cover transition-transform duration-700 ease-out-soft group-hover:scale-105"
                widths={[400, 640, 800]}
                sizes="(min-width: 768px) 33vw, 100vw"
                loading="lazy"
              />
              <div
                class="absolute inset-0 bg-gradient-to-t from-ink/45 via-transparent to-transparent"
                aria-hidden="true"
              />

              <span class="absolute bottom-3 left-3 flex size-9 items-center justify-center rounded-full bg-surface/90 text-primary-deep backdrop-blur-sm">
                <Icon name={service.icon} class="size-5" />
              </span>

              {service.featured && (
                <span class="absolute right-3 top-3 rounded-full bg-primary px-3 py-1 text-xs font-semibold text-primary-fg">
                  Más pedida
                </span>
              )}
            </div>

            <div class="flex flex-1 flex-col p-6 sm:p-7">
              <p class="text-xs font-semibold uppercase tracking-[0.14em] text-primary-deep">{service.tagline}</p>
              <h3 class="mt-2 text-2xl text-fg">{service.name}</h3>

              <p class="mt-1.5 inline-flex items-center gap-1.5 text-sm text-fg-subtle">
                <Icon name="users" class="size-4" />
                {service.capacity}
              </p>

              <p class="mt-4 text-fg-muted">{service.description}</p>

              <ul class="mt-5 space-y-2.5">
                {service.features.map((feature) => (
                  <li class="flex items-start gap-2.5 text-sm text-fg-muted">
                    <Icon name="check" class="mt-0.5 size-4 shrink-0 text-primary" />
                    {feature}
                  </li>
                ))}
              </ul>

              <div class="mt-auto pt-6">
                <div class="border-t border-border pt-5">
                  <p class="font-display text-2xl font-semibold text-fg">{clp(service.price)}</p>
                  <p class="text-xs text-fg-subtle">{service.priceNote}</p>
                </div>

                <a
                  href={whatsappLink(`Hola! Quiero consultar por la ${service.name}.`)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={`mt-5 inline-flex w-full items-center justify-center gap-2 rounded-full px-5 py-3 text-[0.95rem] font-medium transition-all duration-300 active:scale-[0.98] ${
                    service.featured
                      ? "bg-primary text-primary-fg hover:bg-primary-deep"
                      : "border border-border bg-surface text-fg hover:border-primary/40 hover:bg-primary-soft hover:text-primary-deep"
                  }`}
                >
                  <Icon name="whatsapp" class="size-[1.05rem]" />
                  Consultar {service.name}
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <p class="mt-10 text-center text-sm text-fg-subtle" data-reveal>
      Los valores pueden variar según temporada y cantidad de personas. Escríbenos y te confirmamos disponibilidad.
    </p>
  </div>
</section>
