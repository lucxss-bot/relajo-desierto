---
import { Image } from "astro:assets";
import { clp, whatsappLink } from "../../lib/site";
import Icon from "../ui/Icon.astro";

import fotoTinaja from "../../assets/fotos/tinaja-noche.jpg";
import fotoJacuzzi from "../../assets/fotos/jacuzzi-quincho.jpg";
import fotoCabana from "../../assets/fotos/cabanas-atardecer.jpg";

/** Lo mismo para tinaja y jacuzzi: las dos son la experiencia de 90 minutos. */
const incluyeExperiencia = [
  "Tabla dulce y salada",
  "Fruta de temporada",
  "Pizzetas",
  "Una botella a elección: espumante, vino dulce o tinto, cerveza, jugo o limonada de menta y jengibre",
  "Batas durante la experiencia",
  "Souvenir de regalo",
];

const tinaja = {
  price: 67000,
  specs: [
    { label: "Capacidad", value: "Hasta 6 personas" },
    { label: "Duración", value: "90 minutos" },
    { label: "Sistema", value: "Hidromasaje" },
  ],
};

const jacuzzi = {
  price: 67000,
  specs: [
    { label: "Capacidad", value: "Para 2 personas" },
    { label: "Duración", value: "90 minutos" },
    { label: "Sistema", value: "Hidroburbujas" },
  ],
};

const cabana = {
  price: 120000,
  incluye: [
    "Incluye experiencia de tinaja o jacuzzi a elección",
    "Alojamiento en cabaña equipada",
    "2 desayunos",
    "Tabla dulce y salada, fruta, pizzetas y una botella a elección",
    "Batas durante la estadía",
    "Souvenir de regalo",
  ],
};

const wa = (nombre: string) =>
  whatsappLink(`Hola! Quiero reservar ${nombre}. ¿Qué fechas tienen disponibles?`);
---

<section
  id="experiencias"
  class="grain relative isolate scroll-mt-20 overflow-hidden bg-background px-5 py-band-lg sm:px-6"
>
  <!-- Calor ambiental detrás de la sección que más vende, en lugar de
       un relleno de color plano. -->
  <div
    class="pointer-events-none absolute left-1/2 top-0 -z-10 h-[45rem] w-[70rem] -translate-x-1/2 -translate-y-1/4"
    style="background: radial-gradient(ellipse at center, rgba(189,86,55,0.10) 0%, rgba(189,86,55,0) 70%);"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-6xl">
    <div class="max-w-2xl" data-reveal>
      <p class="eyebrow">Experiencias</p>
      <h2 class="mt-6 text-headline leading-[1.06] tracking-[-0.025em] text-fg">Tres formas de venir</h2>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-5 lg:grid-cols-12 lg:gap-6">
      <!-- TINAJA — la más amplia, por eso lleva la foto grande -->
      <article
        class="lift group flex flex-col overflow-hidden rounded-lg border border-border bg-surface shadow-soft hover:-translate-y-1 hover:shadow-lift lg:col-span-7"
        data-reveal
      >
        <div class="relative h-72 overflow-hidden sm:h-80">
          <Image
            src={fotoTinaja}
            alt="Tinaja de madera con agua caliente de noche, con las montañas del Atacama al fondo"
            class="media-zoom size-full object-cover group-hover:scale-105"
            widths={[480, 720, 960]}
            sizes="(min-width: 1024px) 58vw, 100vw"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-ink/50 to-transparent" aria-hidden="true"></div>
          <div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-4 p-6">
            <div>
              <h3 class="text-3xl text-primary-fg">Tinaja</h3>
            </div>
            <span class="flex size-12 shrink-0 items-center justify-center rounded-full bg-primary-fg/15 text-primary-fg backdrop-blur-sm">
              <Icon name="tinaja" class="size-6" />
            </span>
          </div>
        </div>

        <div class="flex flex-1 flex-col p-6 sm:p-8">
          <dl class="grid grid-cols-2 gap-x-6 gap-y-5 sm:grid-cols-3">
            {
              tinaja.specs.map((spec) => (
                <div>
                  <dt class="text-xs font-semibold uppercase tracking-[0.12em] text-fg-subtle">{spec.label}</dt>
                  <dd class="mt-1.5 font-medium text-fg">{spec.value}</dd>
                </div>
              ))
            }
          </dl>

          <p class="mt-8 text-xs font-semibold uppercase tracking-[0.14em] text-fg-subtle">Incluye</p>
          <ul class="mt-4 grid grid-cols-1 gap-x-8 gap-y-3 sm:grid-cols-2">
            {
              incluyeExperiencia.map((item) => (
                <li class="flex items-start gap-2.5 text-sm text-fg-muted">
                  <Icon name="check" class="mt-0.5 size-4 shrink-0 text-primary" />
                  {item}
                </li>
              ))
            }
          </ul>

          <div class="mt-auto flex flex-wrap items-end justify-between gap-5 border-t border-border pt-8">
            <div>
              <p class="font-display text-figure font-semibold leading-none tracking-[-0.03em] text-fg">
                {clp(tinaja.price)}
              </p>
              <p class="mt-2 text-sm text-fg-subtle">
                por 2 personas · adicional {clp(15000)}
              </p>
            </div>
            <a
              href={wa("la tinaja")}
              target="_blank"
              rel="noopener noreferrer"
              class="pressable slide-fill inline-flex items-center justify-center gap-2 rounded-full bg-primary px-6 py-3.5 font-medium text-primary-fg hover:shadow-lift"
            >
              <Icon name="whatsapp" class="size-[1.05rem]" />
              Reservar tinaja
            </a>
          </div>
        </div>
      </article>

      <!-- JACUZZI -->
      <article
        class="lift group flex flex-col overflow-hidden rounded-lg border border-border bg-surface shadow-soft hover:-translate-y-1 hover:shadow-lift lg:col-span-5"
        data-reveal
        style="transition-delay: 110ms"
      >
        <div class="relative h-72 overflow-hidden sm:h-80">
          <Image
            src={fotoJacuzzi}
            alt="Jacuzzi con hidroburbujas y la mesa servida con tabla de picoteo y vino"
            class="media-zoom size-full object-cover group-hover:scale-105"
            widths={[400, 640, 900]}
            sizes="(min-width: 1024px) 42vw, 100vw"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-ink/55 to-transparent" aria-hidden="true"></div>
          <div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-4 p-6">
            <div>
              <h3 class="text-3xl text-primary-fg">Jacuzzi</h3>
            </div>
            <span class="flex size-12 shrink-0 items-center justify-center rounded-full bg-primary-fg/15 text-primary-fg backdrop-blur-sm">
              <Icon name="jacuzzi" class="size-6" />
            </span>
          </div>
        </div>

        <div class="flex flex-1 flex-col p-6 sm:p-8">
          <dl class="space-y-4">
            {
              jacuzzi.specs.map((spec) => (
                <div class="flex items-baseline justify-between gap-4">
                  <dt class="text-xs font-semibold uppercase tracking-[0.12em] text-fg-subtle">{spec.label}</dt>
                  <dd class="font-medium text-fg">{spec.value}</dd>
                </div>
              ))
            }
          </dl>

          <p class="mt-8 text-xs font-semibold uppercase tracking-[0.14em] text-fg-subtle">Incluye</p>
          <ul class="mt-4 space-y-3">
            {
              incluyeExperiencia.map((item) => (
                <li class="flex items-start gap-2.5 text-sm text-fg-muted">
                  <Icon name="check" class="mt-0.5 size-4 shrink-0 text-primary" />
                  {item}
                </li>
              ))
            }
          </ul>

          <div class="mt-auto border-t border-border pt-8">
            <p class="font-display text-figure font-semibold leading-none tracking-[-0.03em] text-fg">
              {clp(jacuzzi.price)}
            </p>
            <p class="mt-2 text-sm text-fg-subtle">por 2 personas · adicional {clp(15000)}</p>

            <a
              href={wa("el jacuzzi")}
              target="_blank"
              rel="noopener noreferrer"
              class="pressable slide-fill mt-6 inline-flex w-full items-center justify-center gap-2 rounded-full bg-primary px-6 py-3.5 font-medium text-primary-fg hover:shadow-lift"
            >
              <Icon name="whatsapp" class="size-[1.05rem]" />
              Reservar jacuzzi
            </a>
          </div>
        </div>
      </article>

      <!-- CABAÑA — el ticket más alto, a todo el ancho y en horizontal -->
      <article
        class="lift group grid grid-cols-1 overflow-hidden rounded-xl border border-border bg-surface shadow-lift hover:shadow-float lg:col-span-12 lg:grid-cols-12"
        data-reveal
        style="transition-delay: 200ms"
      >
        <div class="relative h-64 overflow-hidden sm:h-80 lg:col-span-5 lg:h-auto">
          <Image
            src={fotoCabana}
            alt="Cabañas de adobe con techo de totora al atardecer en Relajo Desierto"
            class="media-zoom size-full object-cover group-hover:scale-105"
            widths={[480, 720, 960]}
            sizes="(min-width: 1024px) 42vw, 100vw"
            loading="lazy"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-ink/45 to-transparent lg:bg-gradient-to-r"
            aria-hidden="true"
          >
          </div>
          <span class="absolute left-6 top-6 rounded-full bg-primary px-3.5 py-1.5 text-xs font-semibold text-primary-fg">
            Con noche incluida
          </span>
        </div>

        <div class="flex flex-col p-6 sm:p-8 lg:col-span-7 lg:p-10">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h3 class="text-3xl text-fg sm:text-4xl">Cabaña</h3>
            </div>
            <span class="flex size-12 shrink-0 items-center justify-center rounded-full bg-primary-soft text-primary-deep">
              <Icon name="cabana" class="size-6" />
            </span>
          </div>

          <p class="mt-4 inline-flex items-center gap-2 text-sm text-fg-subtle">
            <Icon name="clock" class="size-4 shrink-0" />
            Ingreso 16:00 · salida 12:00 del día siguiente
          </p>

          <ul class="mt-7 grid grid-cols-1 gap-x-8 gap-y-3 border-t border-border pt-7 sm:grid-cols-2">
            {
              cabana.incluye.map((item) => (
                <li class="flex items-start gap-2.5 text-sm text-fg-muted">
                  <Icon name="check" class="mt-0.5 size-4 shrink-0 text-primary" />
                  {item}
                </li>
              ))
            }
          </ul>

          <div class="mt-auto flex flex-wrap items-end justify-between gap-5 pt-8">
            <div>
              <p class="font-display text-figure font-semibold leading-none tracking-[-0.03em] text-fg">
                {clp(cabana.price)}
              </p>
              <p class="mt-2 text-sm text-fg-subtle">por 2 personas, noche incluida</p>
            </div>
            <a
              href={wa("la cabaña")}
              target="_blank"
              rel="noopener noreferrer"
              class="pressable slide-fill inline-flex items-center justify-center gap-2 rounded-full bg-primary px-7 py-4 font-medium text-primary-fg hover:shadow-lift"
            >
              <Icon name="whatsapp" class="size-[1.05rem]" />
              Reservar cabaña
            </a>
          </div>
        </div>
      </article>
    </div>

  </div>
</section>
