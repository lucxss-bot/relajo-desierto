---
interface TeamMember {
  name: string;
  role: string;
  bio: string;
}

// PENDIENTE: los cargos de Fernanda y Mauricio siguen siendo un borrador.
const team: TeamMember[] = [
  {
    name: "Verónica",
    role: "Creadora y anfitriona",
    bio: "Creó Relajo Desierto. Recibe a cada visita y deja todo listo antes de que llegues.",
  },
  {
    name: "Fernanda",
    role: "Reservas y atención",
    bio: "Responde los mensajes y coordina cada reserva de principio a fin.",
  },
  {
    name: "Mauricio",
    role: "Mantención",
    bio: "Se encarga del agua, la temperatura y de que cada rincón esté impecable.",
  },
];
---

<section id="nosotros" class="scroll-mt-20 bg-surface-alt px-5 py-band-sm sm:px-6">
  <div class="mx-auto max-w-6xl">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-20">
      <div data-reveal>
        <p class="eyebrow">Nosotros</p>
        <h2 class="mt-6 text-headline leading-[1.06] tracking-[-0.025em] text-fg">
          Una familia, un pedazo de desierto
        </h2>
        <p class="mt-6 max-w-md text-lg text-fg-muted">
          No somos un hotel ni un spa. Somos tres personas que preparan el agua, ponen la mesa y te dejan
          tranquilo.
        </p>
      </div>

      {/* Lista tipográfica en vez de tarjetas: evita repetir por cuarta vez
          la misma receta de borde + sombra + fondo blanco, y no finge tener
          fotos del equipo con avatares de inicial sobre degradado. */}
      <ul class="lg:pt-2">
        {
          team.map((member, i) => (
            <li
              class="grid grid-cols-[auto_1fr] items-baseline gap-x-5 gap-y-1 border-t border-border py-6 first:border-t-0 first:pt-0 sm:gap-x-8"
              data-reveal
              style={`transition-delay: ${i * 90}ms`}
            >
              <h3 class="text-2xl text-fg">{member.name}</h3>
              <p class="text-xs font-semibold uppercase tracking-[0.14em] text-primary-deep">{member.role}</p>
              <p class="col-start-2 mt-1 text-fg-muted">{member.bio}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
