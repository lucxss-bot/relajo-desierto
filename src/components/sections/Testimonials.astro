---
import Icon from "../ui/Icon.astro";

/**
 * OJO: estos testimonios son de ejemplo. Reemplazarlos por opiniones reales
 * de clientes antes de difundir el sitio.
 */
interface Testimonial {
  name: string;
  origin: string;
  text: string;
  rating: number;
}

const [destacado, ...resto]: Testimonial[] = [
  {
    name: "María González",
    origin: "Copiapó",
    text: "Una experiencia increíble. El ambiente es perfecto para desconectarse y el agua estaba a la temperatura justa. Volveríamos sin dudarlo.",
    rating: 5,
  },
  {
    name: "Carlos Méndez",
    origin: "La Serena",
    text: "Excelente atención de principio a fin. La tinaja es cómoda y el silencio del desierto no se compara con nada.",
    rating: 5,
  },
  {
    name: "Ana Silva",
    origin: "Caldera",
    text: "Fue exactamente lo que necesitábamos después de una semana pesada. El equipo es muy amable y todo estaba impecable.",
    rating: 5,
  },
  {
    name: "Juan Rossi",
    origin: "Santiago",
    text: "La cabaña superó nuestras expectativas. Desayuno delicioso, buena onda y una noche de estrellas que no se olvida.",
    rating: 5,
  },
];
---

<section id="opiniones" class="scroll-mt-20 bg-background px-5 py-band-md sm:px-6">
  <div class="mx-auto max-w-6xl">
    <p class="eyebrow" data-reveal>Opiniones</p>

    {/* La primera cita se trata como titular, no como una tarjeta más:
        cuatro cajas idénticas no dicen cuál vale la pena leer. */}
    <figure class="mt-8 max-w-4xl" data-reveal style="transition-delay: 80ms">
      <Icon name="quote" class="size-9 text-primary/30" />
      <blockquote
        class="mt-5 font-display text-2xl leading-[1.35] tracking-[-0.015em] text-fg sm:text-3xl sm:leading-[1.3]"
      >
        {destacado.text}
      </blockquote>
      <figcaption class="mt-7 flex flex-wrap items-center gap-x-4 gap-y-2">
        <span class="font-medium text-fg">{destacado.name}</span>
        <span class="h-3 w-px bg-border" aria-hidden="true"></span>
        <span class="text-fg-muted">{destacado.origin}</span>
        <span class="flex gap-0.5 text-primary" aria-label={`${destacado.rating} de 5 estrellas`}>
          {Array.from({ length: destacado.rating }).map(() => <Icon name="star" class="size-4" />)}
        </span>
      </figcaption>
    </figure>

    <div class="mt-16 grid grid-cols-1 gap-x-10 gap-y-10 border-t border-border pt-12 sm:grid-cols-3">
      {
        resto.map((t, i) => (
          <figure data-reveal style={`transition-delay: ${i * 90}ms`}>
            <span class="flex gap-0.5 text-primary" aria-label={`${t.rating} de 5 estrellas`}>
              {Array.from({ length: t.rating }).map(() => <Icon name="star" class="size-3.5" />)}
            </span>
            <blockquote class="mt-4 text-fg-muted">{t.text}</blockquote>
            <figcaption class="mt-5 text-sm">
              <span class="font-medium text-fg">{t.name}</span>
              <span class="text-fg-subtle"> · {t.origin}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
