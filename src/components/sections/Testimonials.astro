---
interface Testimonial {
  name: string;
  text: string;
  rating: number;
}

const testimonials: Testimonial[] = [
  {
    name: "María González",
    text: "Una experiencia increíble. El ambiente es perfecto para desconectarse. Volvería sin dudarlo.",
    rating: 5
  },
  {
    name: "Carlos Mendez",
    text: "Excelente atención. La tinaja es muy cómoda y relajante. Recomendado 100%.",
    rating: 5
  },
  {
    name: "Ana Silva",
    text: "Fue exactamente lo que necesitaba. El equipo es muy amable y profesional.",
    rating: 5
  },
  {
    name: "Juan Rossi",
    text: "La cabaña superó mis expectativas. Desayuno delicioso y buena onda. Gracias!",
    rating: 5
  }
];

const renderStars = (rating: number) => {
  return "⭐".repeat(rating);
};
---

<section class="py-16 md:py-24 bg-background px-4">
  <div class="max-w-6xl mx-auto">
    <div class="text-center space-y-4 mb-12">
      <h2 class="text-4xl font-bold text-fg">Lo Que Dicen Nuestros Clientes</h2>
      <p class="text-lg text-fg-muted">Testimonios reales de visitantes</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {testimonials.map((testimonial) => (
        <div class="rounded-lg border border-border bg-surface p-6 space-y-3">
          <div class="flex justify-between items-start">
            <div>
              <h4 class="font-semibold text-fg">{testimonial.name}</h4>
            </div>
            <div class="text-sm">{renderStars(testimonial.rating)}</div>
          </div>
          <p class="text-fg-muted italic">"{testimonial.text}"</p>
        </div>
      ))}
    </div>
  </div>
</section>
