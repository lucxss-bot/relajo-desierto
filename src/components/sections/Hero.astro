---
import { Image } from "astro:assets";
import { site, whatsappLink } from "../../lib/site";
import Icon from "../ui/Icon.astro";
import atardecer from "../../assets/fotos/atardecer-panoramica.jpg";

interface Props {
  headline?: string;
  subheadline?: string;
}

const {
  headline = "Tinaja y jacuzzi bajo el cielo del Atacama",
  subheadline = "Agua caliente, silencio y estrellas a minutos de Copiapó. Para dos personas o para seis, por unas horas o con noche incluida.",
} = Astro.props;

const cta = whatsappLink(`Hola ${site.name}! Quiero consultar disponibilidad.`);

const highlights = ["Tinaja para 6 personas", "Jacuzzi para 2", "Cabaña con desayuno"];
---

<section class="relative isolate flex min-h-[calc(100svh-4rem)] items-center overflow-hidden">
  <!-- Foto de fondo -->
  <Image
    src={atardecer}
    alt="Atardecer sobre las cabañas de adobe de Relajo Desierto, en el desierto de Atacama"
    class="absolute inset-0 -z-20 size-full object-cover"
    widths={[640, 960, 1280]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />

  <!-- Velo oscuro para que el texto se lea sobre la foto -->
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-ink/80 via-ink/55 to-ink/85" aria-hidden="true"></div>

  <div class="mx-auto w-full max-w-3xl px-5 py-20 text-center sm:px-6">
    <p class="eyebrow justify-center !text-primary-fg/80 [&::before]:bg-primary-fg/40" data-reveal>
      <Icon name="pin" class="size-3.5" />
      {site.address.locality} · {site.address.city} · {site.address.region}
    </p>

    <h1 class="mt-6 text-primary-fg" data-reveal style="transition-delay: 80ms">
      {headline}
    </h1>

    <p
      class="mx-auto mt-6 max-w-xl text-lg text-primary-fg/85 sm:text-xl"
      data-reveal
      style="transition-delay: 160ms"
    >
      {subheadline}
    </p>

    <div
      class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row"
      data-reveal
      style="transition-delay: 240ms"
    >
      <a
        href={cta}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex w-full items-center justify-center gap-2.5 rounded-full bg-primary px-7 py-3.5 text-base font-medium text-primary-fg shadow-lift transition-all duration-300 hover:bg-primary-deep active:scale-[0.98] sm:w-auto"
      >
        <Icon name="whatsapp" class="size-5" />
        Reservar por WhatsApp
      </a>
      <a
        href="#experiencias"
        class="inline-flex w-full items-center justify-center gap-2 rounded-full border border-primary-fg/35 bg-primary-fg/10 px-7 py-3.5 text-base font-medium text-primary-fg backdrop-blur-sm transition-colors hover:bg-primary-fg/20 sm:w-auto"
      >
        Ver experiencias
      </a>
    </div>

    <ul
      class="mt-10 flex flex-wrap items-center justify-center gap-x-6 gap-y-2.5 text-sm text-primary-fg/80"
      data-reveal
      style="transition-delay: 320ms"
    >
      {
        highlights.map((item) => (
          <li class="inline-flex items-center gap-1.5">
            <Icon name="check" class="size-4 text-primary-fg/60" />
            {item}
          </li>
        ))
      }
    </ul>
  </div>

  <a
    href="#experiencias"
    class="absolute bottom-6 left-1/2 z-10 hidden -translate-x-1/2 text-primary-fg/50 transition-colors hover:text-primary-fg sm:block"
    aria-label="Ir a las experiencias"
  >
    <Icon name="arrow-down" class="size-5 animate-bounce" />
  </a>
</section>
