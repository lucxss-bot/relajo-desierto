---
import { getSiteSettings } from "../lib/sanity";

const settings = await getSiteSettings();
---

<section class="relative min-h-screen bg-gradient-to-b from-background via-background to-surface flex items-center justify-center px-4">
  <div class="max-w-2xl text-center space-y-6">
    <h1 class="text-5xl md:text-6xl font-bold text-fg leading-tight">
      {settings?.heroHeadline || "Relajo Desierto"}
    </h1>
    <p class="text-xl md:text-2xl text-fg-muted">
      {settings?.heroSubheadline || "Bienestar en el Atacama"}
    </p>
    <div class="pt-6">
      <a
        href={`https://wa.me/${settings?.whatsappNumber || "56912345678"}`}
        class="inline-flex items-center justify-center rounded-lg font-semibold bg-primary text-primary-fg px-8 py-4 text-lg hover:opacity-90 transition-opacity"
      >
        {settings?.ctaText || "Reservar por WhatsApp"}
      </a>
    </div>
  </div>
</section>
