---
import { Image } from "astro:assets";
import { site, whatsappLink } from "../../lib/site";
import Icon from "../ui/Icon.astro";
import atardecer from "../../assets/fotos/atardecer-panoramica.jpg";

interface Props {
  /** El eslogan de la marca, partido en las líneas con las que se compone. */
  displayLines?: string[];
  subheadline?: string;
}

const {
  displayLines = ["Donde comienza", "tu descanso"],
  subheadline = "Tinaja o jacuzzi bajo el cielo del Atacama, a minutos de Copiapó. Con tabla, pizzetas y espumante.",
} = Astro.props;

const cta = whatsappLink(`Hola ${site.name}! Quiero consultar disponibilidad.`);

const highlights = ["Tinaja hasta 6", "Jacuzzi hasta 4", "Con o sin alojamiento"];
---

<section
  class="grain grain-dark relative isolate -mt-16 flex min-h-svh items-end overflow-hidden"
  data-on-dark
>
  <!-- Foto de fondo. La deriva lenta evita que la imagen se lea como un fondo fijo. -->
  <Image
    src={atardecer}
    alt="Atardecer sobre las cabañas de adobe de Relajo Desierto, en el desierto de Atacama"
    class="absolute inset-0 -z-20 size-full origin-center object-cover animate-drift"
    widths={[640, 960, 1280]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />

  <!-- Dos velos cruzados en vez de uno: el vertical asienta el texto contra
       el borde inferior, el horizontal lo despega del lado derecho. -->
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink/92 via-ink/58 to-ink/28" aria-hidden="true"></div>

  <!-- Velo propio para la banda del nav: arriba el velo general solo llega
       al 28% y los enlaces crema quedaban en 4.5:1 justo sobre el cielo
       naranja. Con esto suben a 6.2:1. -->
  <div
    class="absolute inset-x-0 top-0 -z-10 h-32 bg-gradient-to-b from-ink/70 via-ink/20 to-transparent"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-r from-ink/75 via-ink/25 to-transparent"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto w-full max-w-6xl px-5 pb-band-md pt-32 sm:px-6">
    <div class="max-w-3xl">
      <p class="eyebrow !text-primary-fg/75 [&::before]:bg-primary-fg/40" data-reveal>
        <Icon name="pin" class="size-3.5" />
        {site.address.locality} · {site.address.city}
      </p>

      <!-- leading y tracking explícitos: el h1 de @layer base fija --tw-leading
           y --tw-tracking, y text-display los lee como fallback, así que sin
           esto el titular se queda con la métrica del h1 normal. -->
      <h1
        class="mt-7 font-display text-display font-semibold leading-[0.94] tracking-[-0.035em] text-primary-fg"
      >
        {
          displayLines.map((line, i) => (
            <span class="line-mask">
              <span class="block animate-unmask" style={`animation-delay: ${120 + i * 110}ms`}>
                {line}
              </span>
            </span>
          ))
        }
      </h1>

      <p
        class="mt-8 max-w-xl text-lg text-primary-fg/80 sm:text-xl"
        data-reveal
        style="transition-delay: 380ms"
      >
        {subheadline}
      </p>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center" data-reveal style="transition-delay: 460ms">
        <a
          href={cta}
          target="_blank"
          rel="noopener noreferrer"
          class="pressable slide-fill inline-flex items-center justify-center gap-2.5 rounded-full bg-primary px-8 py-4 text-base font-medium text-primary-fg shadow-float hover:shadow-lift"
        >
          <Icon name="whatsapp" class="size-5" />
          Reservar por WhatsApp
        </a>
        <a
          href="#experiencias"
          class="pressable slide-fill inline-flex items-center justify-center gap-2 rounded-full border border-primary-fg/30 px-8 py-4 text-base font-medium text-primary-fg backdrop-blur-sm hover:border-primary-fg/60"
          style="--slide: rgb(255 253 251 / 0.16)"
        >
          Ver experiencias
        </a>
      </div>

      <ul
        class="mt-12 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-primary-fg/75"
        data-reveal
        style="transition-delay: 540ms"
      >
        {
          highlights.map((item, i) => (
            <>
              {i > 0 && (
                <li class="hidden h-3 w-px bg-primary-fg/25 sm:block" aria-hidden="true" />
              )}
              <li>{item}</li>
            </>
          ))
        }
      </ul>
    </div>
  </div>

  <span
    class="absolute bottom-5 right-5 hidden h-12 w-px overflow-hidden bg-primary-fg/15 sm:block sm:right-8"
    aria-hidden="true"
  >
    <span class="block h-1/2 w-px bg-primary-fg/70 animate-sink"></span>
  </span>
</section>
