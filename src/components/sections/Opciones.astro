---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { whatsappLink } from "../../lib/site";
import Icon from "../ui/Icon.astro";
import type { IconName } from "../../lib/icons";

import fotoTinaja from "../../assets/fotos/tinaja.jpg";

interface Spec {
  label: string;
  value: string;
}

interface Opcion {
  name: string;
  lead: string;
  description: string;
  specs: Spec[];
  extras: string[];
  icon: IconName;
  photo?: ImageMetadata;
  alt?: string;
  /** Degradado del marcador de posición mientras no haya foto. */
  gradient: string;
  iconColor: string;
}

const opciones: Opcion[] = [
  {
    name: "Tinaja",
    lead: "Para grupos",
    description:
      "Tinaja de madera con agua caliente e hidromasaje, bajo techo de totora. Es la más amplia: cabe un grupo completo sin quedar apretados.",
    specs: [
      { label: "Capacidad", value: "Hasta 6 personas" },
      { label: "Duración", value: "90 minutos" },
      { label: "Material", value: "Madera" },
      { label: "Sistema", value: "Hidromasaje" },
    ],
    extras: ["Techo de totora", "Espacio privado", "Iluminación cálida"],
    icon: "tinaja",
    photo: fotoTinaja,
    alt: "Tinaja de madera con agua caliente bajo techo de totora en Relajo Desierto",
    gradient: "linear-gradient(135deg, #f9e0cd 0%, #e8ac86 100%)",
    iconColor: "#8a4227",
  },
  {
    name: "Jacuzzi",
    lead: "Para parejas",
    description:
      "Jacuzzi con hidroburbujas, en un espacio más recogido. Pensado para venir de a dos, aunque caben hasta cuatro.",
    specs: [
      { label: "Capacidad", value: "Hasta 4 personas" },
      { label: "Duración", value: "90 minutos" },
      { label: "Sistema", value: "Hidroburbujas" },
    ],
    extras: ["Espacio privado", "Ambiente íntimo"],
    icon: "jacuzzi",
    // TODO: falta la foto del jacuzzi. Al agregarla, poner photo y alt como en la tinaja.
    gradient: "linear-gradient(135deg, #efdedb 0%, #cea59d 100%)",
    iconColor: "#7d4a44",
  },
];
---

<section id="opciones" class="scroll-mt-20 bg-surface-alt px-5 py-20 sm:px-6 sm:py-28">
  <div class="mx-auto max-w-6xl">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="eyebrow justify-center">Elige tu agua</p>
      <h2 class="mt-5 text-fg">Tinaja o jacuzzi</h2>
      <p class="mt-4 text-lg text-fg-muted">
        Los dos vienen incluidos en cualquiera de las experiencias, al mismo precio. La diferencia está en el
        tamaño y en el tipo de burbujas.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-8">
      {
        opciones.map((opcion, i) => (
          <article
            class="group flex flex-col overflow-hidden rounded-2xl border border-border bg-surface shadow-soft transition-all duration-500 ease-out-soft hover:-translate-y-1 hover:shadow-lift"
            data-reveal
            style={`transition-delay: ${i * 110}ms`}
          >
            <div class="relative h-64 overflow-hidden sm:h-72">
              {opcion.photo ? (
                <Image
                  src={opcion.photo}
                  alt={opcion.alt ?? ""}
                  class="size-full object-cover transition-transform duration-700 ease-out-soft group-hover:scale-105"
                  widths={[480, 720, 960]}
                  sizes="(min-width: 1024px) 50vw, 100vw"
                  loading="lazy"
                />
              ) : (
                <div
                  class="flex size-full flex-col items-center justify-center gap-3"
                  style={`background: ${opcion.gradient}; color: ${opcion.iconColor}`}
                >
                  <Icon name={opcion.icon} class="size-16" />
                  <span class="text-xs font-medium uppercase tracking-[0.16em] opacity-70">Foto en camino</span>
                </div>
              )}

              <span class="absolute left-4 top-4 rounded-full bg-surface/90 px-3 py-1 text-xs font-semibold uppercase tracking-[0.12em] text-primary-deep backdrop-blur-sm">
                {opcion.lead}
              </span>
            </div>

            <div class="flex flex-1 flex-col p-6 sm:p-8">
              <div class="flex items-center gap-3">
                <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-primary-soft text-primary-deep">
                  <Icon name={opcion.icon} class="size-6" />
                </span>
                <h3 class="text-2xl text-fg">{opcion.name}</h3>
              </div>

              <p class="mt-4 text-fg-muted">{opcion.description}</p>

              <dl class="mt-6 grid grid-cols-2 gap-x-5 gap-y-4 border-t border-border pt-6">
                {opcion.specs.map((spec) => (
                  <div>
                    <dt class="text-xs font-semibold uppercase tracking-[0.12em] text-fg-subtle">{spec.label}</dt>
                    <dd class="mt-1 font-medium text-fg">{spec.value}</dd>
                  </div>
                ))}
              </dl>

              <ul class="mt-6 flex flex-wrap gap-2">
                {opcion.extras.map((extra) => (
                  <li class="inline-flex items-center gap-1.5 rounded-full bg-surface-alt px-3 py-1.5 text-sm text-fg-muted">
                    <Icon name="check" class="size-3.5 text-primary" />
                    {extra}
                  </li>
                ))}
              </ul>

              <div class="mt-auto pt-7">
                <a
                  href={whatsappLink(`Hola! Quiero reservar con ${opcion.name.toLowerCase()}.`)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex w-full items-center justify-center gap-2 rounded-full border border-border bg-surface px-5 py-3.5 font-medium text-fg transition-all duration-300 hover:border-primary/40 hover:bg-primary-soft hover:text-primary-deep active:scale-[0.98]"
                >
                  <Icon name="whatsapp" class="size-[1.05rem]" />
                  Reservar con {opcion.name.toLowerCase()}
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
