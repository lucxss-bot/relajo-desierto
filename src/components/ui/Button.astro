---
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "ghost" | "onDark";
  size?: "sm" | "md" | "lg";
  class?: string;
  external?: boolean;
}

const { href, variant = "primary", size = "md", class: className = "", external = false } = Astro.props;

const base =
  "group inline-flex items-center justify-center gap-2 rounded-full font-medium transition-all duration-300 ease-out-soft active:scale-[0.98]";

const sizes = {
  sm: "px-4 py-2 text-sm",
  md: "px-5 py-2.5 text-[0.95rem]",
  lg: "px-7 py-3.5 text-base",
};

const variants = {
  primary: "bg-primary text-primary-fg shadow-soft hover:bg-primary-deep hover:shadow-lift",
  secondary: "border border-border bg-surface text-fg hover:border-primary/40 hover:text-primary-deep",
  ghost: "text-primary-deep hover:bg-primary-soft",
  onDark: "bg-primary-fg/95 text-ink hover:bg-primary-fg",
};

const classes = `${base} ${sizes[size]} ${variants[variant]} ${className}`;
const rel = external ? "noopener noreferrer" : undefined;
const target = external ? "_blank" : undefined;
---

{
  href ? (
    <a href={href} class={classes} rel={rel} target={target}>
      <slot />
    </a>
  ) : (
    <button type="button" class={classes}>
      <slot />
    </button>
  )
}
