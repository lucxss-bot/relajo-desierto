  {
    name === "quote" && (
      <path d="M9.6 5.2c-3.4 1.5-5.4 4.3-5.4 7.9 0 3.4 1.9 5.7 4.6 5.7 2.2 0 3.8-1.6 3.8-3.7 0-2-1.4-3.5-3.3-3.5-.4 0-.8.1-1 .2.4-1.9 1.9-3.6 4-4.5l-2.7-2.1Zm10 0c-3.4 1.5-5.4 4.3-5.4 7.9 0 3.4 1.9 5.7 4.6 5.7 2.2 0 3.8-1.6 3.8-3.7 0-2-1.4-3.5-3.3-3.5-.4 0-.8.1-1 .2.4-1.9 1.9-3.6 4-4.5l-2.7-2.1Z" />
