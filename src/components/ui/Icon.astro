---
/**
 * Íconos de línea, un solo trazo, tamaño heredado del contenedor.
 * Reemplazan los emojis: se ven igual en todos los dispositivos y toman el color del texto.
 */
import type { IconName } from "../../lib/icons";

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = "size-6" } = Astro.props;

// Los glifos sólidos (marca / decorativos) usan fill; el resto son de trazo.
const filled = new Set<IconName>(["whatsapp", "instagram", "star", "quote"]);
const isFilled = filled.has(name);
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill={isFilled ? "currentColor" : "none"}
  stroke={isFilled ? "none" : "currentColor"}
  stroke-width={isFilled ? undefined : 1.5}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === "tinaja" && (
      <>
        <path d="M3 11h18l-1.4 8.1a2.5 2.5 0 0 1-2.5 2.1H6.9a2.5 2.5 0 0 1-2.5-2.1L3 11Z" />
